{
    "info": {
        "_postman_id": "sharing-vision-article-test",
        "name": "Sharing Vision - Article API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [{
            "key": "baseUrl",
            "value": "http://localhost:8080"
        },
        {
            "key": "articleId",
            "value": "1"
        }
    ],
    "item": [{
            "name": "Create Article",
            "request": {
                "method": "POST",
                "header": [{
                    "key": "Content-Type",
                    "value": "application/json"
                }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"This is an example article title\",\n  \"content\": \"This content is deliberately longer than two hundred characters so that it satisfies the validation requirement from the Sharing Vision backend test. The article can contain substantially more text in an actual application.\",\n  \"category\": \"Technology\",\n  \"status\": \"publish\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/article",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "article"
                    ]
                }
            }
        },
        {
            "name": "Get Articles - Page 1",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/article/10/0",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "article",
                        "10",
                        "0"
                    ]
                }
            }
        },
        {
            "name": "Get Articles - Page 2",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/article/10/10",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "article",
                        "10",
                        "10"
                    ]
                }
            }
        },
        {
            "name": "Get Article",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/article/{{articleId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "article",
                        "{{articleId}}"
                    ]
                }
            }
        },
        {
            "name": "Update Article - PUT",
            "request": {
                "method": "PUT",
                "header": [{
                    "key": "Content-Type",
                    "value": "application/json"
                }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Updated article title with enough characters\",\n  \"content\": \"This is updated content that also needs to contain at least two hundred characters because the same validation rules apply when an article is changed through the update endpoint. This provides enough content for testing.\",\n  \"category\": \"Backend\",\n  \"status\": \"draft\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/article/{{articleId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "article",
                        "{{articleId}}"
                    ]
                }
            }
        },
        {
            "name": "Update Article - PATCH",
            "request": {
                "method": "PATCH",
                "header": [{
                    "key": "Content-Type",
                    "value": "application/json"
                }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Patched article title with enough characters\",\n  \"content\": \"This is patched content that also needs to contain at least two hundred characters because the same validation rules apply when an article is changed through the update endpoint. This provides enough content for testing.\",\n  \"category\": \"Backend\",\n  \"status\": \"publish\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/article/{{articleId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "article",
                        "{{articleId}}"
                    ]
                }
            }
        },
        {
            "name": "Move Article to Thrash",
            "request": {
                "method": "PUT",
                "header": [{
                    "key": "Content-Type",
                    "value": "application/json"
                }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Updated article title with enough characters\",\n  \"content\": \"This is updated content that also needs to contain at least two hundred characters because the same validation rules apply when an article is changed through the update endpoint. This provides enough content for testing.\",\n  \"category\": \"Backend\",\n  \"status\": \"thrash\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/article/{{articleId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "article",
                        "{{articleId}}"
                    ]
                }
            }
        },
        {
            "name": "Delete Article",
            "request": {
                "method": "DELETE",
                "url": {
                    "raw": "{{baseUrl}}/article/{{articleId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "article",
                        "{{articleId}}"
                    ]
                }
            }
        }
    ]
}